# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Used to sign login sessions. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Anthropic API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP settings for sending OTP emails. Any provider works
# (Gmail app password, SendGrid, Postmark, Resend's SMTP, Mailgun, etc).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.address@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Runway Resume <your.address@gmail.com>"

# Comma-separated list of origins allowed to call this API.
# In production on Render, leave this EMPTY — the frontend is served from the
# same Express process so no CORS header is needed.
# Only set this for local dev if you run the frontend on a separate port.
# Example: CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=
